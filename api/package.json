{
  "name": "pingverse-api",
  "version": "3.2.0",
  "private": true,
  "description": "Pingverse API server - auth, chat, and admin moderation over REST + Socket.IO, backed by a local SQLite database (Node's built-in node:sqlite - no native build step).",
  "type": "module",
  "main": "dist/src/index.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && node --no-warnings dist/src/index.js",
    "set-role": "npm run build && node --no-warnings dist/scripts/set-role.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie": "^1.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  }
}
