# Copy this file to .env and fill in real values before starting the server.
# Never commit the real .env file.

# Port the API + Socket.IO server listens on
PORT=4000

# Path to the local SQLite database file (created automatically on first run)
DATABASE_PATH=./data/pingverse.db

# Exact origin of the web frontend (no trailing slash). Required for CORS
# and for the cookie/CSRF origin check. In production this is your real
# domain, e.g. https://chat.example.com
CLIENT_URL=http://localhost:3000

# Secret used to sign session JWTs. MUST be at least 32 random characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# How long a login session lasts
JWT_EXPIRES_IN=24h

# Cookie hardening. Use "true" and sameSite=none only when the API is
# served over HTTPS (required by browsers for Secure+SameSite=None).
# If the web app and API share the same top-level domain, "lax" is enough.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Set to "true" when running behind a reverse proxy (nginx, Caddy, etc.)
# so Express trusts X-Forwarded-* headers for correct client IPs/rate limiting.
TRUST_PROXY=false

# NOTE: there are no access/admin keys any more. New accounts start as
# "pending" and must be approved by an admin. Admins are created by
# setting the role in the database:  npm run set-role -- <username> admin
